# Maintainer: CharOfString <root@charofstring.cc>
pkgname=deepin-calculator-git
pkgver=6.5.37
pkgrel=1
pkgdesc='Easy to use calculator for GXDE'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/deepin-calculator"
license=('GPL-3.0-or-later' 'GPL-2.0-or-later' 'LGPL-3.0-or-later' 'CC-BY-4.0' 'CC0-1.0')
depends=('dtk6core-git' 'dtk6gui-git' 'dtk6widget-git' 'qt6-base' 'qt6-svg' 'hicolor-icon-theme' 'libgcc'
         'libstdc++' 'glibc')
# 构建时运行的 lupdate 需要 libQt6Qml ・ The lupdate run during the build needs libQt6Qml.
makedepends=('git' 'cmake' 'ninja' 'pkgconf' 'qt6-tools' 'qt6-declarative')
provides=('deepin-calculator')
conflicts=('deepin-calculator' 'gxde-calculator-git')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  # 与 debian/rules 相同 ・ Same as debian/rules.
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF \
    -DCMAKE_SAFETYTEST_ARG=CMAKE_SAFETYTEST_ARG_OFF \
    -DAPP_VERSION="$pkgver" \
    -DVERSION="$pkgver"
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
  # 与 debian/manpages 相同 ・ Same as debian/manpages.
  install -Dm644 "$(_srcroot)/debian/deepin-calculator.1" "$pkgdir/usr/share/man/man1/deepin-calculator.1"
}
